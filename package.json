{
  "name": "expense-splitter-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:prodtest": "ng serve --configuration production",
    "clean": "rimraf ./dist",
    "build:prod": "ng build --configuration production",
    "build:prodaot": "ng build --configuration production",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCustom",
    "test-local": "ng test",
    "test:nowatch": "ng test --watch=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "s3:delete": "aws s3 rm s3://angular-expenses-splitter --recursive",
    "s3:upload": "aws s3 cp ./dist/expense-splitter-frontend s3://angular-expenses-splitter --recursive --include \"*\"",
    "s3": "npm run s3:delete && npm run s3:upload",
    "firebase": "firebase deploy",
    "deploy": "npm run build:prodaot && npm run firebase",
    "build:ci": "npm run clean && npm run test && npm run build:prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.4",
    "@angular/cdk": "^21.1.4",
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/core": "^21.1.4",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^21.1.4",
    "@angular/material": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "@angular/router": "^21.1.4",
    "@angular/service-worker": "^21.1.4",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.3",
    "fast-copy": "^3.0.2",
    "firebase": "^12.9.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "^7.8.1",
    "tesseract.js": "^5.1.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "angular-eslint": "^21.2.0",
    "aws-sdk": "^2.1693.0",
    "eslint": "^9.0.0",
    "firebase-admin": "^13.0.2",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^23.11.1",
    "typescript": "~5.9.3"
  }
}
